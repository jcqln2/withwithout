# Local monitoring stack. Copy to .env if you need to override the defaults.
# Do not put real Optimum credentials in this file's committed copy.

POSTGRES_USER=verifier
POSTGRES_PASSWORD=verifier
POSTGRES_DB=verifier
TIMESCALE_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Phase 1 collector. This public Hoodi API is an observer feed, not a Track A arm.
BEACON_API_URL=https://beacon.hoodi.ethpandaops.io
NODE_ID=hoodi-public-1
ARM=observer
BLOCK_GOSSIP=true
COLLECTOR_PORT=8080

# Phase 2. Request these from Optimum. Leave empty until then.
# OPT_API_KEY=
# OPT_GATEWAY_CLUSTER_ID=
